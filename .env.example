# ==========================================
# AI FireGuard - Environment Configuration
# ==========================================

# Ethereum Sepolia Testnet Infura RPC Endpoint
INFURA_URL=https://sepolia.infura.io/v3/your_infura_api_key

# Ethereum Account Private Key (Used to sign on-chain logs)
PRIVATE_KEY=your_metamask_private_key_without_quotes

# Deployed FirewallLogs Smart Contract Address on Sepolia
CONTRACT_ADDRESS=0x82a09f0d6DbEA12F465e84E11D5043FB18532f7C

# Optional: If hosting backend on an external server (e.g. Render/Railway), set its URL:
# VITE_BACKEND_URL=https://your-custom-backend.railway.app
